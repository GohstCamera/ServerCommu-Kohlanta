command /server:
    permission: serveur.menu
    permission message: "&cVous n'avez pas la permission d'utiliser cette commande."
    trigger:
        open chest inventory with 3 rows named "&6&l✦ Sélection du Mode de Jeu ✦" to player
        wait 1 tick

        # Agencement esthétique des slots
        # Ligne du haut
        set slot 10 of player's current inventory to campfire named "&e&l⛺ Koh-Lanta" with lore "&7Rejoignez l'aventure." and "&7Clique pour commencer."
        set slot 12 of player's current inventory to iron bars named "&b&l🏋 Ninja Warrior" with lore "&7Montrez votre agilité." and "&7Clique pour tenter votre chance."
        set slot 14 of player's current inventory to diamond sword named "&c&l⚔ Tournois PVP" with lore "&7Soyez le dernier survivant." and "&7Clique pour combattre."
        set slot 16 of player's current inventory to player head named "&d&l💡 Hickabrain" with lore "&7Défiez votre logique." and "&7Clique pour participer."

        # Ligne du milieu avec un design symétrique
        set slot 20 of player's current inventory to stone named "&7&l🪨 The Platform" with lore "&7Montez au sommet." and "&7Clique pour gravir la plateforme."
        set slot 22 of player's current inventory to emerald block named "&a&l🌿 Plateau" with lore "&7Explorez la verdure." and "&7Clique pour commencer."

        # Ligne du bas avec l’option de retour
        set slot 24 of player's current inventory to red bed named "&6&l🏠 Retour au Lobby" with lore "&7Revenez au point de départ." and "&7Clique pour retourner."

        # Ajout des vitres décoratives sans erreur
        set {_slots::*} to numbers between 0 and 26
        loop {_slots::*}:
            if slot (loop-value) of player's current inventory is not set:
                set slot (loop-value) of player's current inventory to gray stained glass pane named "&7❖"

on inventory click:
    if name of event-inventory is "&6&l✦ Sélection du Mode de Jeu ✦":
        cancel event
        if player has permission "role.presentateur":
            send "&eTéléportation en cours, votre rôle reste inchangé." to player
        else:
            send "&eTéléportation en cours et changement de rôle effectué." to player

        # Téléportations sans changement de rôle pour le rôle présentateur
        if index of event-slot is 10:
            execute player command "mvtp world"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set KohLanta"
        if index of event-slot is 12:
            execute player command "mvtp Ninja_Warrior"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set Ninja_Warrior"
        if index of event-slot is 14:
            execute player command "mvtp PVP2"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set PVP"
        if index of event-slot is 16:
            execute player command "mvtp Hickabrain"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set hickabrain"
        if index of event-slot is 20:
            execute player command "mvtp The_Platform"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set The_Platform"
        if index of event-slot is 22:
            execute player command "mvtp Gab"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set Plateau"
        if index of event-slot is 24:
            execute player command "mvtp %player% lobby"
            if player does not have permission "role.presentateur":
                execute console command "lp user %player% parent clear"
                execute console command "lp user %player% parent set default"
